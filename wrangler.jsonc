{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "th-dd",
  "compatibility_date": "2026-11-15",
  // 纯静态：没有 main，Worker 只负责直出 dist 里的资源
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // 故意不声明 routes / custom_domain：www 的 DNS 现在是优选 CNAME（外部管理的记录），
  // Workers 无法再把它认成自定义域；声明了每次部署都会报 [code: 100117] 并让构建变红。
  // 域名、证书、缓存策略由优选方与 CF DNS 侧维护；apex → www 的 301 是 CF Redirect Rule。
  "observability": { "enabled": true }
}
