---
import { useTastro } from "@sipc.ink/tastro"
import { marked } from "marked";
import { readFile } from "node:fs/promises";
import { existsSync } from "node:fs";
import { join } from "node:path";

const { lang } = useTastro(Astro.request)

// 配置 marked
marked.setOptions({
    breaks: true,
    gfm: true
});

// 根据语言选择 README 文件名
const readmeFile = lang === "zh" ? "README_zh-cn.md" : "README.md";

// 多个镜像源，按优先级排序（将内容最新的源提到最前面）
const readmeSources = [
    `https://raw.githubusercontent.com/th-dd/th-dd/main/${readmeFile}`,  // 1. GitHub raw (内容最新)
    `https://ghp.th-dd.top/https://raw.githubusercontent.com/th-dd/th-dd/main/${readmeFile}`, // 2. 自建镜像 (raw 被墙时兜底)
    `https://gitee.com/ya2/ya2/raw/main/${readmeFile}`,                  // 3. Gitee 镜像
    `https://cdn.jsdelivr.net/gh/th-dd/th-dd@main/${readmeFile}`,        // 4. jsDelivr CDN (有缓存，作为备用)
    // `https://raw.staticdn.net/th-dd/th-dd/main/${readmeFile}`         // 5. staticdn (打不开，已注释)
];

let readmeHtml = null;
let loadError = null;

// 渲染并加固 marked 产物：图片懒加载 + 异步解码，外链新窗口且断开 opener
// 3D 贡献图改成构建期光栅化的同图 WebP：SVG 在滚动容器里每次重绘都要重新光栅化，
// 实测主线程 15s → 0.09s；GitHub 那边的 README 仍用 SVG。没有光栅文件时退回 SVG。
const hasRaster3d = existsSync(join(process.cwd(), "public/profile-night-rainbow.webp"));

function renderReadme(md) {
    let html = marked.parse(md)
        // README 里那张 6MB 动图不该阻塞首屏
        .replaceAll("<img ", '<img loading="lazy" decoding="async" ')
        .replaceAll('<a href="http', '<a target="_blank" rel="noopener noreferrer" href="http');

    if (hasRaster3d) {
        html = html.replace(/src="[^"]*\/profile-night-rainbow\.svg"/g, 'src="/profile-night-rainbow.webp"');
    }
    return html;
}

// 1. 构建期优先读本地文件：内容永远与仓库一致，也不依赖网络
try {
    const md = await readFile(join(process.cwd(), readmeFile), "utf8");
    if (md.trim()) readmeHtml = renderReadme(md);
} catch {
    loadError = "本地 README 读取失败，已改走镜像";
}

// 2. 本地没有（或为空）再按顺序走镜像
for (const url of readmeSources) {
    if (readmeHtml) break;
    try {
        const response = await fetch(url);
        if (response.ok) {
            const md = await response.text();
            if (md && md.length > 0) {
                readmeHtml = renderReadme(md);
                break;
            }
        }
    } catch (error) {
        loadError = error.message;
        // 继续尝试下一个源
    }
}
---

<div class="glass-card readme-card">
    <div class="readme-header" id="readme-toggle">
        <h4 class="readme-title">📖 README</h4>
        <button class="toggle-btn" id="readme-toggle-btn" aria-label="切换 README 显示">
            <svg class="toggle-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </button>
    </div>
    <div class="readme-content-wrapper" id="readme-content-wrapper">
        <div class="readme-content">
            {readmeHtml ? (
                <div set:html={readmeHtml} />
            ) : (
                <div style="text-align:center; padding:30px 20px; color:var(--text-muted);">
                    <p style="margin-bottom:12px;">⚠️ README 加载失败</p>
                    <p style="font-size:12px;">请直接访问 <a href="https://github.com/th-dd/th-dd" target="_blank" style="color:#58a6ff;">GitHub 仓库</a> 查看</p>
                    {loadError && <p style="font-size:11px; margin-top:8px; opacity:0.6;">错误信息: {loadError}</p>}
                </div>
            )}
        </div>
    </div>
</div>

<style>
    .readme-card {
        width: 100%;
        padding: 20px;
        /* 内容要滚动，去掉 backdrop-filter：否则每帧都要重算整卡模糊 */
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        background: var(--bg-card-strong) !important;
    }
    
    /* 折叠容器兼作渐隐遮罩的定位基准 */
    .readme-content-wrapper {
        position: relative;
    }
    
    /* 用一层静态渐变替代 mask-image（mask 会让整块内容多一层合成） */
    .readme-content-wrapper::after {
        content: "";
        position: absolute;
        left: 0;
        right: 8px;
        bottom: 0;
        height: 26px;
        pointer-events: none;
        background: linear-gradient(to bottom, transparent, var(--bg-card-strong));
    }
    
    .readme-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
        cursor: pointer;
        user-select: none;
    }
    
    .readme-header:hover .toggle-btn {
        opacity: 0.8;
    }
    
    .readme-title {
        font-size: 16px;
        color: var(--text-primary);
        margin: 0;
        flex: 1;
    }
    
    .toggle-btn {
        background: none;
        border: none;
        color: var(--text-secondary);
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0.6;
    }
    
    .toggle-btn:hover {
        background: var(--btn-bg);
        opacity: 1;
    }
    
    .toggle-btn:focus-visible {
        outline: 2px solid var(--text-primary);
        outline-offset: 2px;
    }
    
    .toggle-icon {
        transition: transform 0.3s ease;
    }
    
    .toggle-icon.collapsed {
        transform: rotate(-90deg);
    }
    
    .readme-content-wrapper {
        overflow: hidden;
        transition: max-height 0.4s ease, opacity 0.3s ease;
        max-height: 600px;
        opacity: 1;
    }
    
    .readme-content-wrapper.collapsed {
        max-height: 0 !important;
        opacity: 0;
        padding-top: 0;
        margin-top: 0;
    }
    
    .readme-content {
        font-size: 14px;
        line-height: 1.7;
        color: var(--text-secondary);
        max-height: 500px;
        overflow-y: auto;
        padding-right: 8px;
        padding-top: 4px;

    }
    
    /* Markdown 渲染样式 */
    /* 居中块：README 顶部标题、签名与链接行 */
    .readme-content :global([align="center"]) {
        text-align: center;
    }
    
    .readme-content :global([align="center"] blockquote) {
        border-left: none;
        background: none;
        padding: 0;
        margin: 6px 0 10px;
    }
    
    .readme-content :global(h1) {
        font-size: 1.25em;
        margin: 2px 0 6px;
        color: var(--text-primary);
        font-weight: 700;
        letter-spacing: 0.02em;
    }
    
    .readme-content :global(h2) {
        font-size: 1.02em;
        margin: 18px 0 6px;
        color: var(--text-primary);
        font-weight: 600;
        letter-spacing: 0.04em;
        opacity: 0.9;
    }
    
    .readme-content :global(h3) {
        font-size: 1.15em;
        margin: 14px 0 6px;
        color: var(--text-primary);
        font-weight: 600;
    }
    
    .readme-content :global(h4) {
        font-size: 1em;
        margin: 12px 0 6px;
        color: var(--text-primary);
        font-weight: 600;
    }
    
    .readme-content :global(h5),
    .readme-content :global(h6) {
        font-size: 0.9em;
        margin: 10px 0 4px;
        color: var(--text-primary);
        font-weight: 600;
    }
    
    .readme-content :global(p) {
        margin: 6px 0;
        color: var(--text-secondary);
    }
    
    /* 顶部链接行：紧凑分隔，别换行成瀑布 */
    .readme-content :global([align="center"] p) {
        font-size: 13px;
        line-height: 1.9;
        margin: 0;
        color: var(--text-muted);
    }
    
    .readme-content :global(a) {
        color: #58a6ff;
        text-decoration: none;
        transition: color 0.2s;
    }
    
    .readme-content :global(a:hover) {
        text-decoration: underline;
        color: #79c0ff;
    }
    
    .readme-content :global(strong) {
        color: var(--text-primary);
        font-weight: 700;
    }
    
    .readme-content :global(em) {
        color: var(--text-secondary);
        font-style: italic;
    }
    
    .readme-content :global(del) {
        color: var(--text-muted);
    }
    
    .readme-content :global(code) {
        background: var(--btn-bg);
        padding: 2px 6px;
        border-radius: 4px;
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
        font-size: 0.88em;
        color: #f0883e;
    }
    
    .readme-content :global(pre) {
        background: var(--bg-card-inner);
        padding: 14px;
        border-radius: 8px;
        overflow-x: auto;
        margin: 10px 0;
        border: 1px solid var(--border-color);
    }
    
    .readme-content :global(pre code) {
        background: transparent;
        padding: 0;
        color: var(--text-primary);
        font-size: 0.85em;
    }
    
    .readme-content :global(ul),
    .readme-content :global(ol) {
        margin: 8px 0;
        padding-left: 24px;
    }
    
    .readme-content :global(li) {
        margin: 4px 0;
        color: var(--text-secondary);
    }
    
    .readme-content :global(li input[type="checkbox"]) {
        margin-right: 6px;
    }
    
    .readme-content :global(blockquote) {
        border-left: 3px solid var(--border-color);
        padding: 4px 12px;
        margin: 10px 0;
        color: var(--text-muted);
        background: var(--btn-bg);
        border-radius: 0 6px 6px 0;
    }
    
    .readme-content :global(blockquote p) {
        margin: 4px 0;
    }
    
    .readme-content :global(table) {
        border-collapse: collapse;
        width: 100%;
        margin: 12px 0;
        display: block;
        overflow-x: auto;
    }
    
    .readme-content :global(th),
    .readme-content :global(td) {
        border: 1px solid var(--border-color);
        padding: 8px 12px;
        text-align: left;
    }
    
    .readme-content :global(th) {
        background: var(--btn-bg);
        color: var(--text-primary);
        font-weight: 600;
    }
    
    .readme-content :global(td) {
        color: var(--text-secondary);
    }
    
    /* 图片统一居中、限宽限高，长图不再把卡片撑爆 */
    .readme-content :global(img) {
        display: block;
        /* 位图最多 480：比这更大的光栅在滚动时更吃重绘 */
        max-width: min(100%, 480px);
        max-height: 300px;
        object-fit: contain;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        margin: 8px 0;
        background: rgba(0, 0, 0, 0.12);
    }
    
    /* 游戏动图源只有 420 宽，别放大到糊 */
    .readme-content :global(img[src$="game.webp"]) {
        max-width: min(100%, 420px);
    }
    
    /* 矢量图（3D 贡献图）放大不糊，按卡片宽度铺满 */
    .readme-content :global(img[src$=".svg"]),
    .readme-content :global(img[src$="profile-night-rainbow.webp"]) {
        width: 100%;
        max-height: 420px;
        height: auto;
    }
    
    .readme-content :global(hr) {
        border: none;
        border-top: 1px solid var(--border-color);
        margin: 14px 0 10px;
    }
    
    /* 滚动条样式 */
    .readme-content::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }
    
    .readme-content::-webkit-scrollbar-track {
        background: transparent;
    }
    
    .readme-content::-webkit-scrollbar-thumb {
        background: var(--border-color);
        border-radius: 3px;
    }
    
    .readme-content::-webkit-scrollbar-thumb:hover {
        background: var(--text-muted);
    }
</style>

<script>
    (function() {
        const toggleBtn = document.getElementById('readme-toggle-btn');
        const wrapper = document.getElementById('readme-content-wrapper');
        const icon = toggleBtn?.querySelector('.toggle-icon');
        
        if (!toggleBtn || !wrapper) return;
        
        // 从 localStorage 读取折叠状态
        const isCollapsed = localStorage.getItem('readme-collapsed') === 'true';
        
        // 应用初始状态
        if (isCollapsed) {
            wrapper.classList.add('collapsed');
            icon?.classList.add('collapsed');
        }
        
        // 点击切换
        toggleBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            const willCollapse = !wrapper.classList.contains('collapsed');
            
            wrapper.classList.toggle('collapsed');
            icon?.classList.toggle('collapsed');
            
            // 保存状态到 localStorage
            localStorage.setItem('readme-collapsed', String(willCollapse));
        });
        
        // 点击整个 header 也可以触发
        const header = document.getElementById('readme-toggle');
        header?.addEventListener('click', function(e) {
            // 如果点击的是按钮本身，按钮的 click 事件已经处理了
            if (e.target.closest('.toggle-btn')) return;
            toggleBtn.click();
        });
    })();
</script>