---
import { useTastro } from "@sipc.ink/tastro"
import { marked } from "marked";
const { t, lang } = useTastro(Astro.request)

// 配置 marked
marked.setOptions({
    breaks: true,
    gfm: true
});

// 根据语言选择 README 文件名
const readmeFile = lang === "zh" ? "README.md" : "README_en.md"

// 多个镜像源，按优先级排序（国内可访问的优先）
const readmeSources = [
    `https://cdn.jsdelivr.net/gh/th-dd/th-dd@main/${readmeFile}`,
    `https://gitee.com/ya2/ya2/raw/main/${readmeFile}`,
    `https://raw.staticdn.net/th-dd/th-dd/main/${readmeFile}`,
    `https://raw.githubusercontent.com/th-dd/th-dd/main/${readmeFile}`
];
---

<div class="glass-card readme-card">
    <div class="readme-header">
        <h4 class="readme-title">📖 README</h4>
        <span class="readme-lang-badge">{lang === "zh" ? "中文" : "EN"}</span>
    </div>
    <div id="readme-content" class="readme-content">
        <div class="readme-loading">
            <span class="loading-spinner"></span>
            <span>{lang === "zh" ? "加载中..." : "Loading..."}</span>
        </div>
    </div>
</div>

<style>
    .readme-card {
        width: 100%;
        padding: 20px;
    }
    
    .readme-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 16px;
    }
    
    .readme-title {
        font-size: 16px;
        color: var(--text-primary);
        margin: 0;
    }
    
    .readme-lang-badge {
        font-size: 11px;
        padding: 2px 8px;
        border-radius: 10px;
        background: var(--btn-bg);
        color: var(--text-secondary);
        border: 1px solid var(--border-color);
    }
    
    .readme-content {
        font-size: 14px;
        line-height: 1.7;
        color: var(--text-secondary);
        max-height: 500px;
        overflow-y: auto;
        padding-right: 8px;
    }
    
    .readme-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: var(--text-muted);
        padding: 40px 20px;
    }
    
    .loading-spinner {
        width: 16px;
        height: 16px;
        border: 2px solid var(--border-color);
        border-top-color: var(--text-primary);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }
    
    @keyframes spin {
        to { transform: rotate(360deg); }
    }
    
    /* Markdown 渲染样式 */
    .readme-content :global(h1) {
        font-size: 1.5em;
        margin: 20px 0 10px;
        color: var(--text-primary);
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 8px;
        font-weight: 700;
    }
    
    .readme-content :global(h2) {
        font-size: 1.3em;
        margin: 18px 0 8px;
        color: var(--text-primary);
        font-weight: 600;
    }
    
    .readme-content :global(h3) {
        font-size: 1.15em;
        margin: 14px 0 6px;
        color: var(--text-primary);
        font-weight: 600;
    }
    
    .readme-content :global(h4) {
        font-size: 1em;
        margin: 12px 0 6px;
        color: var(--text-primary);
        font-weight: 600;
    }
    
    .readme-content :global(h5),
    .readme-content :global(h6) {
        font-size: 0.9em;
        margin: 10px 0 4px;
        color: var(--text-primary);
        font-weight: 600;
    }
    
    .readme-content :global(p) {
        margin: 8px 0;
        color: var(--text-secondary);
    }
    
    .readme-content :global(a) {
        color: #58a6ff;
        text-decoration: none;
        transition: color 0.2s;
    }
    
    .readme-content :global(a:hover) {
        text-decoration: underline;
        color: #79c0ff;
    }
    
    .readme-content :global(strong) {
        color: var(--text-primary);
        font-weight: 700;
    }
    
    .readme-content :global(em) {
        color: var(--text-secondary);
        font-style: italic;
    }
    
    .readme-content :global(del) {
        color: var(--text-muted);
    }
    
    .readme-content :global(code) {
        background: var(--btn-bg);
        padding: 2px 6px;
        border-radius: 4px;
        font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
        font-size: 0.88em;
        color: #f0883e;
    }
    
    .readme-content :global(pre) {
        background: var(--bg-card-inner);
        padding: 14px;
        border-radius: 8px;
        overflow-x: auto;
        margin: 10px 0;
        border: 1px solid var(--border-color);
    }
    
    .readme-content :global(pre code) {
        background: transparent;
        padding: 0;
        color: var(--text-primary);
        font-size: 0.85em;
    }
    
    .readme-content :global(ul),
    .readme-content :global(ol) {
        margin: 8px 0;
        padding-left: 24px;
    }
    
    .readme-content :global(li) {
        margin: 4px 0;
        color: var(--text-secondary);
    }
    
    .readme-content :global(li input[type="checkbox"]) {
        margin-right: 6px;
    }
    
    .readme-content :global(blockquote) {
        border-left: 3px solid var(--border-color);
        padding: 4px 12px;
        margin: 10px 0;
        color: var(--text-muted);
        background: var(--btn-bg);
        border-radius: 0 6px 6px 0;
    }
    
    .readme-content :global(blockquote p) {
        margin: 4px 0;
    }
    
    .readme-content :global(table) {
        border-collapse: collapse;
        width: 100%;
        margin: 12px 0;
        display: block;
        overflow-x: auto;
    }
    
    .readme-content :global(th),
    .readme-content :global(td) {
        border: 1px solid var(--border-color);
        padding: 8px 12px;
        text-align: left;
    }
    
    .readme-content :global(th) {
        background: var(--btn-bg);
        color: var(--text-primary);
        font-weight: 600;
    }
    
    .readme-content :global(td) {
        color: var(--text-secondary);
    }
    
    .readme-content :global(img) {
        max-width: 100%;
        border-radius: 8px;
        margin: 8px 0;
    }
    
    .readme-content :global(hr) {
        border: none;
        border-top: 1px solid var(--border-color);
        margin: 16px 0;
    }
    
    /* 滚动条样式 */
    .readme-content::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }
    
    .readme-content::-webkit-scrollbar-track {
        background: transparent;
    }
    
    .readme-content::-webkit-scrollbar-thumb {
        background: var(--border-color);
        border-radius: 3px;
    }
    
    .readme-content::-webkit-scrollbar-thumb:hover {
        background: var(--text-muted);
    }
</style>

<script>
    // 多镜像源 fallback 加载
    async function loadReadme() {
        const contentEl = document.getElementById('readme-content');
        const lang = document.documentElement.lang;
        const file = (lang === 'zh' || lang === 'zh-CN') ? 'README.md' : 'README_en.md';
        
        const sources = [
            `https://cdn.jsdelivr.net/gh/th-dd/th-dd@main/${file}`,
            `https://gitee.com/ya2/ya2/raw/main/${file}`,
            `https://raw.staticdn.net/th-dd/th-dd/main/${file}`,
            `https://raw.githubusercontent.com/th-dd/th-dd/main/${file}`
        ];
        
        let lastError = null;
        
        for (let i = 0; i < sources.length; i++) {
            try {
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 5000);
                
                const response = await fetch(sources[i], { signal: controller.signal });
                clearTimeout(timeoutId);
                
                if (response.ok) {
                    const md = await response.text();
                    if (md && md.length > 0) {
                        // 使用 marked 解析 markdown
                        const html = marked.parse(md);
                        contentEl.innerHTML = html;
                        return;
                    }
                }
            } catch (error) {
                lastError = error;
                console.warn(`Source ${i + 1} failed:`, sources[i], error.message);
                // 继续尝试下一个源
            }
        }
        
        // 所有源都失败
        contentEl.innerHTML = `
            <div style="text-align:center; padding:30px 20px; color:var(--text-muted);">
                <p style="margin-bottom:12px;">⚠️ README 加载失败</p>
                <p style="font-size:12px;">请直接访问 <a href="https://github.com/th-dd/th-dd" target="_blank" style="color:#58a6ff;">GitHub 仓库</a> 查看</p>
            </div>
        `;
        console.error('All README sources failed. Last error:', lastError);
    }
    
    loadReadme();
</script>
